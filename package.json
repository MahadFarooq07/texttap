{
  "name": "texttap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run verify:download && next build",
    "verify:download": "node scripts/verify-download.mjs",
    "typecheck": "tsc --noEmit",
    "publish:extension": "node scripts/publish-extension.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "lucide-react": "1.48.0",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "3.9.9",
    "typescript": "^5"
  }
}
